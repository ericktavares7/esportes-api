PORT=3000
# Fonte de todos os dados de futebol (goal-api.com, 1000 requisicoes/dia no plano gratis)
GOAL_API_KEY=

# Opcional: so pra abrir jogos antigos de "Jogos pesquisados" salvos antes da migracao
# (id numerico da API Futebol). O resto do app nao usa.
API_FUTEBOL_KEY=

# Chat (aba Chat) - opcional. Cada usuário também pode colar a própria chave
# direto na engrenagem da aba Chat (fica só no navegador dele); essas aqui
# servem só de fallback pra quem prefere configurar uma vez no servidor.
ANTHROPIC_API_KEY=coloque_sua_chave_aqui
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=coloque_sua_chave_aqui
OPENAI_MODEL=gpt-5.6
GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash
